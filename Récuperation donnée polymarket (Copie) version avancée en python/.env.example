GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
RTDS_WS_URL=wss://ws-live-data.polymarket.com

SAMPLE_INTERVAL_MS=500
VOL_WINDOW_TICKS=120
DISCOVERY_INTERVAL_SECONDS=5
LOG_LEVEL=INFO

DATA_DIR=data_5m
LOG_DIR=logs
RUNTIME_CONTROL_SOCKET_PATH=/tmp/polymarket_btc5m_control.sock

COINBASE_VOL_WINDOW_CANDLES=60
COINBASE_POLL_INTERVAL_SECONDS=10
COINBASE_SOURCE_MODE=auto
COINBASE_PRODUCT_ID=BTC-USD
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
COINBASE_RT_ENABLED=true
COINBASE_RT_BAR_MS=200
COINBASE_RT_EWMA_HALFLIFE_S=12
COINBASE_RT_WINDOW_FAST_S=30
COINBASE_RT_WINDOW_SLOW_S=120
COINBASE_RT_STALE_AFTER_MS=6000

# First window only: copy "Price to beat" from Polymarket (CLI --strike overrides this)
# INITIAL_STRIKE_USD=66848.13
# STRIKE_OVERRIDES_PATH=data_5m/strike_overrides.json
# STRIKE_CONFIDENCE_THRESHOLD=0.92
# STRIKE_CONFIDENCE_GAP_MS=1500
# STRIKE_ALLOW_APPROX_AUTO=false
# STRIKE_EXACT_TOLERANCE_MS=0

# Keep enabled to guarantee displayed spot freshness when chainlink RTDS is sparse.
RTDS_FAST_BTCUSDT=true

# Optional Coinbase credentials (not required for public candles)
# COINBASE_API_KEY=
# COINBASE_API_SECRET=
# COINBASE_API_PASSPHRASE=
